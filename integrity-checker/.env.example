# Copy this file to .env and fill in your real values.

# PostgreSQL
DATABASE_URL=postgresql://DB_USER:DB_PASS@192.168.178.X/DB_NAME

# MinIO
MINIO_ENDPOINT=192.168.178.X:9000
MINIO_ACCESS_KEY=your_minio_user
MINIO_SECRET_KEY=your_minio_password
MINIO_BUCKET=evidence

# Vault / OpenBao
# Set VAULT_SKIP_VERIFY=true when the server uses a self-signed TLS certificate
VAULT_URL=https://192.168.178.X:8200
VAULT_TOKEN=your_vault_token
VAULT_SKIP_VERIFY=false
HMAC_SECRET_PATH=secret/hmac_key

# Integrity Checker
CHECK_INTERVAL_SECONDS=60
