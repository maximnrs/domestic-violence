# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=evidence_user
POSTGRES_PASSWORD=evidence_pass
POSTGRES_DB=evidence_db
DATABASE_URL=postgresql://evidence_user:evidence_pass@postgres:5432/evidence_db

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=evidence

# ── OpenBao / Vault ───────────────────────────────────────────────────────────
# Internal address used by api and integrity_checker containers
OPENBAO_ADDR=http://openbao:8200
# Token created automatically on first docker compose up --build
# If the entrypoint prints a different token, update this value and restart
OPENBAO_TOKEN=evidence-service-token
HMAC_SECRET_PATH=secret/hmac_key

# ── Integrity Checker ─────────────────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=60

# ── Host ports (what Proxmox exposes to your network) ────────────────────────
# Access the API at http://<proxmox-ip>:8000/docs
# Access MinIO console at http://<proxmox-ip>:9001
# Access OpenBao UI at http://<proxmox-ip>:8200
# Replace <proxmox-ip> with your actual Proxmox container IP, e.g. 192.168.1.50
